    {
      "name": "4. Resilience (first run: docker compose stop route-service)",
      "description": "Stop the Route Service first: `docker compose stop route-service`. Then send these requests one by one and watch `docker compose logs -f permit-service`. Restart with `docker compose start route-service` and wait 15 seconds for the circuit to close.",
      "item": [
        {
          "name": "Create permit while Route Service is DOWN -> 503 (retries)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/permits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "permits"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"route_id\": \"{{routeId}}\",\n  \"trekker_name\": \"Kenji Tanaka\",\n  \"passport_number\": \"RS0000001\",\n  \"nationality\": \"Japan\",\n  \"group_size\": 4,\n  \"start_date\": \"{{startDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 503\", () => pm.response.to.have.status(503));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create permit again -> 503",
          "request": {
            "method": "POST",
            "header": [
