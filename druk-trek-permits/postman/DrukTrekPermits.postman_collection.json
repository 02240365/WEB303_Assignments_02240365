  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// start_date = 30 days from today, so the permit date is always valid",
          "const d = new Date(); d.setDate(d.getDate() + 30);",
          "pm.collectionVariables.set('startDate', d.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
