# =============================================================================
# Environment configuration for docker compose (read automatically).
# Demo values for a local assignment setup — change passwords for real use.
# =============================================================================

# ---- Ports ------------------------------------------------------------------
GATEWAY_PORT=8080
ROUTE_GRPC_PORT=50051
PERMIT_GRPC_PORT=50052

# ---- Route Service database (route_db) --------------------------------------
ROUTE_DB_NAME=route_db
ROUTE_DB_USER=route_user
ROUTE_DB_PASSWORD=route_pass

# ---- Permit Service database (permit_db) ------------------------------------
PERMIT_DB_NAME=permit_db
PERMIT_DB_USER=permit_user
PERMIT_DB_PASSWORD=permit_pass

# ---- Resilience: Permit Service -> Route Service ----------------------------
# deadline for EACH attempt
ROUTE_CALL_TIMEOUT=2s
# retries after the first attempt (3 attempts total)
ROUTE_MAX_RETRIES=2
# first wait; doubles each retry (200ms, 400ms)
ROUTE_RETRY_BACKOFF=200ms
# consecutive failures that OPEN the circuit
ROUTE_CB_FAILURES=3
# time the circuit stays OPEN before HALF-OPEN
ROUTE_CB_OPEN_TIMEOUT=15s

# ---- Gateway ----------------------------------------------------------------
# max time for one HTTP request
GATEWAY_REQUEST_TIMEOUT=10s
